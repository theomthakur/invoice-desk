# Copy as a starting point for your shell environment. Do not commit real values.
# The application reads environment variables; it does not automatically load this file.
APP_ENV=local
DATA_DIR=data/runtime
STORAGE_PERSISTENCE=local
MODEL_MODE=mock

# Optional cloud inference. Key and budget are required; set a provider-side limit too.
# Choose openrouter or xai explicitly. Keys are not interchangeable.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
XAI_API_KEY=
MODEL_BUDGET_USD=
# Leave blank for provider defaults: OpenRouter x-ai/grok-4.7; xAI grok-4.7.
LLM_MODEL=
# Leave blank for the selected provider endpoint.
LLM_BASE_URL=
MODEL_CALL_LIMIT=8
TOOL_CALL_LIMIT=6
RUN_TIMEOUT_SECONDS=90

# Needed for hosted use. The access code is not a user identity or enterprise sign-in.
DEMO_ACCESS_CODE=
SESSION_SECRET=
# Local mode persists an owner-only generated key in DATA_DIR when this is omitted.
# Keep that key with a database backup. Production still requires an explicit secret.
# Local offline default. Set to 1 for browser AI with a key and spending limits.
ALLOW_LIVE_IN_SESSIONS=0

# Optional real offline inference. Requires an installed Ollama model with tool support.
# Start separately: OLLAMA_NO_CLOUD=1 ollama serve
# Set LLM_PROVIDER=ollama and LLM_MODEL=qwen2.5:7b, then choose live mode.
# Experimental: local clean-invoice checks held invoices unnecessarily. No cloud fallback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
